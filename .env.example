IBKR_BASE_URL=https://api.ibkr.com/v1/api
IBKR_CONSUMER_KEY=
IBKR_REALM=limited_poa
IBKR_ACCESS_TOKEN=
IBKR_ACCESS_TOKEN_SECRET=
IBKR_SIGNATURE_KEY_PATH=./secrets/ibkr-oauth/private_signature.pem
IBKR_ENCRYPTION_KEY_PATH=./secrets/ibkr-oauth/private_encryption.pem
IBKR_DH_PARAM_PATH=./secrets/ibkr-oauth/dhparam.pem
IBKR_TIMEOUT_SECONDS=30
IBKR_LST_CACHE_MODE=memory
IBKR_REDIS_KEY_PREFIX=ibkr:oauth:lst
IBKR_LST_REFRESH_SKEW_SECONDS=60
IBKR_LST_LOCK_TTL_SECONDS=15
# Optional: Redis LST cache, database lookup/persistence, and operator defaults.
# IBKR_REDIS_URL=redis://127.0.0.1:6379/0
# IBKR_DATABASE=postgres://user:password@localhost:5432/database
# IBKR_ACCOUNT_ID=DU123456
# IBKR_QUICK_ORDER_PREFIX=quick-vwap
# IBKR_ORDERS_ANSWER_JSON=./order_answers.example.json
# IBKR_LOG=warn
